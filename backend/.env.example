# ── Groq (required) ───────────────────────────────────────────────────────────
# Get from: https://console.groq.com/ → API Keys → Create API Key
GROQ_API_KEY=gsk_your_key_here

# ── LangSmith (optional — LLM call tracing) ───────────────────────────────────
# Get from: https://smith.langchain.com/ → Settings → API Keys → Create API Key
# Set to false to disable tracing entirely
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls__your_key_here
LANGSMITH_PROJECT=coding-agent

# ── Database ──────────────────────────────────────────────────────────────────
# For local dev, SQLite is fine
DATABASE_URL=sqlite:///./dev.db

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=replace-this-with-a-random-string-at-least-32-chars

# ── Agent ─────────────────────────────────────────────────────────────────────
# Max times the agent tries to fix the code before giving up
AGENT_MAX_ATTEMPTS=3

# Directory where repos are cloned
AGENT_REPO_WORK_DIR=/tmp/agent-repos